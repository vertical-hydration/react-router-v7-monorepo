{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reserve",
  "main": "./workers/app.ts",

  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],

  "observability": {
    "enabled": true
  },

  "d1_databases": [{
    "binding": "DB",
    "database_name": "rrv7-monorepo",
    "database_id": "50f69dd7-e632-4a6d-9cdd-6b1d79db90d8"
  }],

  "vars": {
    "ENVIRONMENT": "production",
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    "BETTER_AUTH_URL": "https://reserve.foodpantrythomasville.org",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://reserve.foodpantrythomasville.org"
  },

  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare (Preview)",
        "BETTER_AUTH_URL": "https://preview.reserve.foodpantrythomasville.org",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://preview.reserve.foodpantrythomasville.org"
      }
    }
  }
}
